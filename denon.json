{
    "scripts": {
        "start": {
            "cmd": "deno run src/server/server.ts",
            "desc": "run my server",
            "allow": ["net", "read", "write", "env", "ffi"],
            "watch": ["src/", "public/"]
        },
        "live": {
            "cmd": "deno run src/server/livereload.ts",
            "allow": ["net", "read", "write", "env", "ffi"],
            "watch": ["src/", "public/"]
        }
    }
}
